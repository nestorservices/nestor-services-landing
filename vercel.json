{
  "framework": "vite",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nestorservices.in"
        }
      ],
      "destination": "https://www.nestorservices.in/:path*",
      "permanent": true
    },
    {
      "source": "/invoice",
      "destination": "https://invoice-creation-app.vercel.app",
      "permanent": false
    },
    {
      "source": "/invoice/:path*",
      "destination": "https://invoice-creation-app.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
  ]
}
